# Credenciales de Google Gemini (Obtener gratis en https://aistudio.google.com/)
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Conexion a PostgreSQL 16 con pgvector (Docker local)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/rag_knowledge_base

# Configuracion del Modelo
EMBEDDING_MODEL=models/text-embedding-004
CHAT_MODEL=gemini-2.5-flash

# Parametros de Chunking
CHUNK_SIZE=700
CHUNK_OVERLAP=100

# Umbral de similitud minima (0.0 a 1.0)
SIMILARITY_THRESHOLD=0.65
TOP_K_CHUNKS=4
